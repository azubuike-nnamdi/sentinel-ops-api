# Application
NODE_ENV=development
PORT=8000
APP_NAME=SentinelOps
APP_URL=http://localhost:8000
API_PREFIX=api/v1

# MongoDB (local)
# MONGODB_URI=mongodb://localhost:27017/sentinelops

# MongoDB Atlas — replace <db_password> with your Atlas database user password
MONGODB_URI=mongodb+srv://ctrlaltfix-softwares:<db_password>@cluster0.urec7pi.mongodb.net/sentinelops?retryWrites=true&w=majority&appName=Cluster0

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# Security
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,http://localhost:8000,http://127.0.0.1:8000
THROTTLE_TTL=60
THROTTLE_LIMIT=100
BCRYPT_SALT_ROUNDS=12

# Logging
LOG_LEVEL=info

# OpenTelemetry
OTEL_ENABLED=false
OTEL_SERVICE_NAME=sentinelops-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# FastAPI Isolation Forest service (sentinel-ops-ai)
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT_MS=10000
# When true, NestJS falls back to heuristic RCA if FastAPI is down
AI_FALLBACK_ENABLED=true
